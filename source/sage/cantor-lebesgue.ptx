<?xml version="1.0" encoding="UTF-8"?>
<figure xml:id="fig-cantor-lebesgue">
<caption>The Cantor-Lebesgue function on the set <m>U</m>.</caption>

<interactive dark-mode-enabled="yes" xml:id="cantor-lebesgue-interactive" platform="sage" width="100%"  preview="images/Cantor-Lebesgue.png">
    <shortdescription>
        An interactive look at the construction of the Cantor-Lebesgue function
    </shortdescription>
    <description>
        <p>
            An interactive element with a slider allowing a value of <m>n</m> to show the first <m>n</m> steps  in the construction of the Cantor-Lebesgue function <m>\phi</m>.
        </p>
    </description>
        <slate surface = "sage">
            def S1(L):
                return [1/3 * n for n in L]

            def S2(L):
                return [1/3 * n + 2/3 for n in L]

            def S(L):
                return S1(L) + S2(L)

            StartingInterval = [0,1]

            @interact
            def _(iteration=slider([1 .. 7])):
                n = iteration
                C = StartingInterval

                for k in range(n):
                    C = S(C)

                phi = plot(1/2, 1/3, 2/3, thickness = 1.5)

                for i in range(1,2**n):
                    flat_line = plot(i/(2**n),C[2*i-1],C[2*i], thickness=1.5)
                    phi = phi + flat_line
                
                pretty_print(html(r'Construction of $\phi$ on $\bigcup_{k=1}^{%s} U_k$.' % latex(n)))
                show(phi, xmin=0,xmax=1, ymin=0,ymax=1)
        </slate>
</interactive>
</figure>