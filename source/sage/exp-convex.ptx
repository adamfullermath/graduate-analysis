<?xml version="1.0" encoding="UTF-8"?>

<figure xml:id="fig-exp-convex">
    <caption>
    <p>The function <m>f(x)=e^x</m> is convex</p>
    </caption>
    <image>
        <shortdescription>Graph of the function f(x) = exp(x) with x between -0.5 and 1.5, together with a line segment joining to points on the curve. </shortdescription>
        <description>
            <p>
                The graph of <m>f(x) = e^x</m> with <m>-0.5 \leq x \leq 1.5</m>.
                Two points <m>(u, f(u))</m> and <m>(v, f(v))</m> are shown, with the straight line segment between them.
                The line segment lies above the curve, illustrating that <m>f(x) = e^x</m> is convex.
            </p>
        </description>
        <sageplot label="exp-convex">
            f(x) = exp(x)

            u= 0.1
            v = 1.3

            tick = [[u,v],[1,2,3,4]]
            ticks_labels = [['$u$','$v$'],None]
            x_axis = [-0.5,1.5]
            y_axis= [0,4]

            plt = plot(f,[-0.5,2.5],legend_label=r'$f(x)=e^x$', ticks=tick, tick_formatter=ticks_labels)
            plt += line([(u,f(u)),(v,f(v))],color="purple",legend_label=r'Line segment from $(u,f(u))$ to $(v,f(v))$')

            <!-- plt.set_legend_options(loc='lower right') -->
            plt.set_axes_range(x_axis[0],x_axis[1],y_axis[0],y_axis[1])

            plt
        </sageplot>
    </image>        
</figure>

