<?xml version="1.0" encoding="UTF-8"?>

<figure xml:id="fig-cantor">
    <caption>The first several steps in the construction of the Cantor set.</caption>
    <image>
        <shortdescription>The first several steps in the construction of the Cantor set.</shortdescription>
        <description>
            <p>
                The first several steps in the construction of the Cantor set are shown.
                On top, there is <m>C_0 = [0,1]</m>.
                Below, we have <m>C_1 = [0,1/3] \cup [2/3,1]</m>, then <m>C_2 = [0,1/9] \cup [2/9,1/3] \cup [2/3,7/9]\cup[8/9,1]</m>.
                This continues down to <m>C_5</m>, removing the middle third from each interval in the step above.
            </p>
        </description>    

            <sageplot label="cantor">
                def line_segment(a,b,n=0):
                    T = [[a,n],[b,n]]
                    return line(T, axes=False)

                StartingInterval = [0,1]

                C = StartingInterval
                N = 5

                L = line_segment(StartingInterval[0],StartingInterval[1],3/4)

                label = text(r"$C_0$", (1.1,3/4),fontsize=11)
                numbers =text("0", (-0.01,0.75),color="black", fontsize = (10)  ) + text("1", (1.01,3/4),color="black", fontsize = (10)  )

                label = label + numbers

                n = N
                for k in range(n):
                    C = [1/3 * n for n in C] + [1/3 * n + 2/3 for n in C]
                    level = k+1

                    for i in range(0,len(C),2):
                        L = L + line_segment(C[i],C[i+1],1/(k+2))                        
                            
                        numbers = None
                        if k &lt;= 1:
                            left_number = text("%s" % C[i], (C[i],1/(k+2)+0.01),color="black", fontsize = (10 - 2*k)  )
                            right_number = text("%s" % C[i+1], (C[i+1],1/(k+2)+0.01),color="black", fontsize = (10 - 2*k)  )
                            numbers = left_number + right_number
                                
                        label = label + text(r"$C_{%s}$" % latex(level), (1.1,1/(k+2)),fontsize=11)
                            
                        if numbers:
                            label = label + numbers

                    <!-- pretty_print(html(r'Plots of $C_n$ for $n$ up to $%s$' % latex(n))) -->
                    <!-- show(L+label, axes=false) -->
                plt = L + label
                plt
            </sageplot>

        
    </image>
</figure>

