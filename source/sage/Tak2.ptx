<?xml version="1.0" encoding="UTF-8"?>
<figure xml:id="fig-Tak3">
    <caption>
    Takagi's example <m>f(x) = \sum_{n=0}^\infty \frac{g(2^nx)}{2^n}</m>.
    </caption>
    <image>
        <shortdescription>Takagi's example</shortdescription>
        <description>
            <p>
                Visualization of Takagi's example of a nowhere differentiable function.
                The graph is fractal like in nature, symmetric about the vertical line <m>x=1/2</m>.
                It is said to resemble a Blancmange dessert.
            </p>
        </description>

        <sageplot label="Takagi">
            g(x) = min_symbolic( x -floor(x),ceil(x)-x)

            N = 10
            b = 2
            f(x) = sum([g(b^k*x)/(b^k) for k in range(N)])

            plt = plot(f(x), (x,0,1))
            plt
        </sageplot>
    </image>
</figure>