<?xml version="1.0" encoding="UTF-8"?>
<figure xml:id="fig-Cantor-Lebesgue-x">
    <caption>The function <m>\psi(x)=\phi(x)+x</m> used in the proof of <xref ref="lem-non-Borel"/>.</caption>

    <image>
        <shortdescription>The function psi(x) = phi(x) + x, where phi is the Cantor-Lebesgue function.</shortdescription>
        <description>
            <p>
                The function <m>\psi(x) = \phi(x) + x</m>, where <m>\phi(x)</m> is the Cantor-Lebesgue function.
                The function <m>\psi</m> is continuous and strictly increasing with domain <m>[0,1]</m> and range <m>[0,2]</m>.
                If <m>C</m> is the Cantor set, then <m>\psi</m> is linear on the disjoint intervals comprising <m>U = [0,1]\backslash C</m>.
            </p>
        </description>

        <sageplot label="Cantor-Lebesgue-x">
            StartingInterval = [0,1]

            C = StartingInterval
            n = 7

            for k in range(n):
                C = [1/3* c for c in C] + [1/3 * c + 2/3 for c in C]

            m = (1/(2**n))/C[1]
            CLx = plot((m+1)*x,C[0],C[1])
            height = 1/(2**n)
            
            for i in range(1,len(C)-1):
                if mod(i,2) == 0:
                    CLx += plot(m*(x-C[i]) +height+x,C[i],C[i+1])
                    height = height + 1/(2**n)
                else:
                    CLx += plot(height+x, C[i], C[i+1])
                
            CLx
        </sageplot>
    </image>
</figure>    